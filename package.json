{
  "name": "rajshree",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--dns-result-order=ipv4first' next dev",
    "build": "prisma generate && node scripts/prune-prisma-nft.mjs && next build",
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first' next start",
    "lint": "eslint",
    "test": "vitest run",
    "postinstall": "prisma generate && node scripts/prune-prisma-nft.mjs",
    "db:push": "NODE_OPTIONS='--dns-result-order=ipv4first' prisma db push",
    "db:seed": "NODE_OPTIONS='--dns-result-order=ipv4first' prisma db seed",
    "db:generate": "prisma generate && node scripts/prune-prisma-nft.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "cross-env": "^10.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
