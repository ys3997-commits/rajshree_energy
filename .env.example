# Supabase Auth (login only — not used for data access)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Prisma → Supabase Postgres
#
# IMPORTANT: Do NOT use the direct host db.<ref>.supabase.co:5432 from most
# local networks — it is often IPv6-only and Prisma/Node will fail with P1001.
#
# Use Session pooler (recommended for Prisma):
#   Project Settings → Database → Connect → ORMs → Prisma
#   or Connection string → URI → Session pooler
#
# Example (port 5432 on pooler host, user includes project ref):
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# If password contains # @ : / etc, URL-encode them (# → %23)
