# Supabase Auth (login only — not used for data access)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Prisma → Supabase Postgres
#
# IMPORTANT: Do NOT use the direct host db.<ref>.supabase.co:5432 from most
# local networks — it is often IPv6-only and Prisma/Node will fail with P1001.
# The app also forces IPv4-first DNS in src/lib/prisma.ts for the pooler host.
#
# Use the pooler (ORMs → Prisma in Supabase dashboard).
#
# DATABASE_URL = Transaction pooler (port 6543) for the app.
#   pgbouncer=true + a low connection_limit avoid EMAXCONNSESSION
#   (session pool is only ~15 clients total).
#   pool_timeout=20 lets a query wait if the 5 slots are busy.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20&sslmode=require"
#
# DIRECT_URL = Session pooler (port 5432) for prisma db push / migrate.
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# If password contains # @ : / etc, URL-encode them (# → %23)

# Optional. Signs staff login cookies. Falls back to the anon key if unset.
AUTH_SECRET=generate-a-long-random-string
