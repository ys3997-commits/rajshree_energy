generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  /// native for local dev; rhel-openssl-3.0.x for Vercel Node runtimes
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CustomerCategory {
  SUPPLIER
  INDUSTRY
  TRADER
}

enum OrderType {
  REGULAR
  OPEN
}

/// Sale / purchase order lifecycle — Running until fully dispatched, then Completed.
enum OrderStatus {
  RUNNING
  COMPLETED
}

enum PurchaseOrderStatus {
  RUNNING
  COMPLETED
}

enum ReceiptStatus {
  PENDING
  RECEIVED
}

/// Delivery terms on a dispatch: FOR (freight included in sale rate) or Ex-Port (buyer arranges transport).
enum DispatchTerms {
  FOR
  EX_PORT
}

enum PaymentDirection {
  RECEIVED
  SENT
}

enum DiscountStatus {
  RECEIVED
  PAID
}

model Staff {
  id        String   @id @default(cuid())
  name      String
  role      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealByCustomers Customer[] @relation("DealBy")
  orders          Order[]
}

model Transporter {
  id                  String   @id @default(cuid())
  /// Transport company name
  name                String
  ownerName           String?
  ownerContactNumber1 String?
  ownerContactNumber2 String?
  email               String?
  city                String?
  state               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  dispatches Dispatch[]
}

/// Managed list of origin names (Indonesia, Coal India, …).
model OriginOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qualityClasses QualityClass[]
}

/// Managed list of quality grades (6000 GCV, Coal Fines, …).
model QualityOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qualityClasses QualityClass[]
}

/// Managed list of ports / locations (Haldia Port, Odisha, …).
model PortOption {
  id        String   @id @default(cuid())
  name      String   @unique
  /// GST state for dispatches via vessels at this port.
  state     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vessels Vessel[]
  orders  Order[]
}

/// Managed list of sales executives (suggested on customers; stored as text).
model SaleExecutiveOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Managed list of cities (suggested on customers/transporters; stored as text).
model CityOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Managed list of states (suggested on customers/transporters; stored as text).
model StateOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Managed list of industry sectors (suggested on customers; stored as text).
model SectorOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Managed list of dealing companies (suggested across the app; stored as text).
model DealingCompanyOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A coal quality class: origin + domestic flag + quality grade.
model QualityClass {
  id              String   @id @default(cuid())
  originId        String
  domestic        Boolean
  qualityOptionId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  origin         OriginOption    @relation(fields: [originId], references: [id])
  qualityOption  QualityOption   @relation(fields: [qualityOptionId], references: [id])
  vessels        Vessel[]
  orders         Order[]
  purchaseOrders PurchaseOrder[]

  @@unique([originId, domestic, qualityOptionId])
}

model Customer {
  id                       String           @id @default(cuid())
  name                     String
  category                 CustomerCategory
  active                   Boolean          @default(true)
  ownerName                String?
  ownerContact             String?
  purchaserName            String?
  purchaserContact         String?
  purchaserRole            String?
  paymentInChargeName      String?
  paymentInChargeContact   String?
  paymentInChargeRole      String?
  accountantName           String?
  accountantContact        String?
  factoryContactName       String?
  factoryContactContact    String?
  factoryContactRole       String?
  email                    String?
  city                     String?
  state                    String?
  creditDays               Int?
  sector                   String?
  saleExecutive            String?
  dealById                 String?
  approachForFunds         String?
  /// Suggested dealing company name (from Options list; stored as text).
  dealingCompany           String?
  /// Carry-forward balance from before this system (manual). Included in `due`.
  openingDue               Decimal          @default(0) @db.Decimal(18, 2)
  /// Net amount owed by the customer to Rajshree (openingDue + sales − purchases − received + sent − discount paid + discount received).
  due                      Decimal          @default(0) @db.Decimal(18, 2)
  /// Next planned collection phone call date (calendar day).
  plannedCollectionCallDate DateTime?
  /// Next planned sales call date (calendar day) — separate from collection.
  plannedSaleCallDate      DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  dealBy           Staff?          @relation("DealBy", fields: [dealById], references: [id])
  orders           Order[]
  purchaseOrders   PurchaseOrder[]
  dispatches       Dispatch[]      @relation("DispatchImporter")
  payments         Payment[]
  discounts        Discount[]
}

model Vessel {
  id             String   @id @default(cuid())
  vesselName     String   @unique
  qualityClassId String?
  portId         String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  qualityClass   QualityClass?    @relation(fields: [qualityClassId], references: [id])
  port           PortOption?      @relation(fields: [portId], references: [id])
  purchaseOrders PurchaseOrder[]
  dispatches     Dispatch[]
}

/// Sale order (customer PO / selling side).
model Order {
  id             String      @id @default(cuid())
  poNumber       String      @unique
  orderType      OrderType   @default(REGULAR)
  customerId     String
  orderDate      DateTime?
  portId         String?
  creditDays     Int?
  qualityClassId String?
  /// Base sale rate entered by user (Rs/MT), before GST/TCS.
  rate           Decimal?    @db.Decimal(18, 3)
  /// All-in sale rate: rate + GST(18%); traders also add TCS(2% of rate+GST).
  finalRate      Decimal?    @db.Decimal(18, 3)
  /// Null for open orders until completeOpenOrder fills it in.
  quantity       Decimal?    @db.Decimal(18, 3)
  /// Optional planned lorry count entered at order creation.
  numberOfLorries Int?
  /// Sale delivery terms (FOR / Ex-Port). Independent of dispatch terms. Null until set.
  deliveryTerms  DispatchTerms?
  orderById      String?
  /// Accumulated by dispatch transactions only — never write from forms.
  dispatchedOrder Decimal    @default(0) @db.Decimal(18, 3)
  /// Undispatchable remainder written off via "close quantity"; zeros balance.
  closingQuantity Decimal?   @db.Decimal(18, 3)
  orderStatus    OrderStatus @default(RUNNING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id])
  orderBy      Staff?        @relation(fields: [orderById], references: [id])
  port         PortOption?   @relation(fields: [portId], references: [id])
  qualityClass QualityClass? @relation(fields: [qualityClassId], references: [id])
  dispatches   Dispatch[]
}

/// Purchase order (vendor / costing side). Linked to a vessel.
model PurchaseOrder {
  id         String      @id @default(cuid())
  poNumber   String      @unique
  orderType  OrderType   @default(REGULAR)
  importerId String
  vesselId   String
  orderDate      DateTime?
  qualityClassId String?
  /// Base cost rate entered by user (Rs/MT), before GST/TCS.
  rate           Decimal?    @db.Decimal(18, 3)
  /// All-in cost: rate + GST(18%) + TCS(2% of rate+GST).
  finalRate      Decimal?    @db.Decimal(18, 3)
  /// Null for open purchase orders until completed.
  quantity       Decimal?    @db.Decimal(18, 3)
  /// Accumulated by dispatch transactions only — never write from forms.
  dispatchedOrder Decimal     @default(0) @db.Decimal(18, 3)
  /// Undispatchable remainder written off via "close quantity"; zeros balance.
  closingQuantity Decimal?    @db.Decimal(18, 3)
  orderStatus     PurchaseOrderStatus @default(RUNNING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  importer     Customer      @relation(fields: [importerId], references: [id])
  vessel       Vessel        @relation(fields: [vesselId], references: [id])
  qualityClass QualityClass? @relation(fields: [qualityClassId], references: [id])
  dispatches   Dispatch[]
}

model Dispatch {
  id                  String        @id @default(cuid())
  poNumber            String
  purchasePoNumber    String
  vesselId            String
  dispatchDate        DateTime
  dispatchedQuantity  Decimal       @db.Decimal(18, 3)
  lorryNumber         String?
  dispatchTerms       DispatchTerms @default(EX_PORT)
  /// Freight per MT (Rs/MT) — required for FOR; stripped from sale rate for profit.
  freight             Decimal?      @db.Decimal(18, 3)
  transporterId       String?
  importerId          String?
  receivingQuantity   Decimal?      @db.Decimal(18, 3)
  receiptDate         DateTime?
  receiptStatus       ReceiptStatus @default(PENDING)
  softCopyStatus      Boolean       @default(false)
  entryInTally        Boolean       @default(false)
  /// Transport checklist — bilty (goods receipt) hard copy received.
  biltyHardCopy       Boolean       @default(false)
  /// Transport checklist — transporter invoice number.
  transportInvoiceNo  String?
  /// Transport checklist — sale/transport invoice hard copy received.
  invoiceHardCopy     Boolean       @default(false)
  /// Sale (customer) invoice number — often filled after dispatch.
  saleInvoiceNumber     String?
  /// Purchase (supplier) invoice number — often filled after dispatch.
  purchaseInvoiceNumber String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  order         Order         @relation(fields: [poNumber], references: [poNumber], onUpdate: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchasePoNumber], references: [poNumber], onUpdate: Cascade)
  vessel        Vessel        @relation(fields: [vesselId], references: [id])
  transporter   Transporter?  @relation(fields: [transporterId], references: [id])
  importer      Customer?     @relation("DispatchImporter", fields: [importerId], references: [id])

  @@index([receiptStatus])
  @@index([vesselId])
  @@index([purchasePoNumber])
}

/// Money received from or sent to a customer.
model Payment {
  id         String           @id @default(cuid())
  date       DateTime
  customerId String
  direction  PaymentDirection
  amount     Decimal          @db.Decimal(18, 2)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([date])
}

/// Discount received from or paid to a customer.
model Discount {
  id         String         @id @default(cuid())
  date       DateTime
  customerId String
  status     DiscountStatus
  amount     Decimal        @db.Decimal(18, 2)
  remarks    String         @default("")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([date])
}
