generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  /// native for local dev; rhel-openssl-3.0.x for Vercel Node runtimes
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CustomerCategory {
  SUPPLIER
  INDUSTRY
  TRADER
}

enum OrderType {
  REGULAR
  OPEN
}

/// Sale / purchase order lifecycle — Running until fully dispatched, then Completed.
enum OrderStatus {
  RUNNING
  COMPLETED
}

enum PurchaseOrderStatus {
  RUNNING
  COMPLETED
}

enum ReceiptStatus {
  PENDING
  RECEIVED
}

/// Delivery terms on a dispatch: FOR (freight included in sale rate) or Ex-Port (buyer arranges transport).
enum DispatchTerms {
  FOR
  EX_PORT
}

enum PaymentDirection {
  RECEIVED
  SENT
}

enum DiscountStatus {
  RECEIVED
  PAID
}

enum CoalOrigin {
  DOMESTIC
  IMPORTED
}

enum BillStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CollectionThrough {
  CALL
  SMS
}

model Staff {
  id                      String   @id @default(cuid())
  name                    String
  role                    String?
  /// Set when this person may log in. Owner uses Supabase instead.
  passwordHash            String?
  /// Page keys this person may open. Ignored for the owner account.
  pageKeys                String[] @default([])
  /// Sales executives visible in Collection Engine. ["*"] = all; else executive names.
  collectionSalesExecs    String[] @default([])
  /// Sales executives visible in Sales Engine Report. ["*"] = all; else executive names.
  salesEngineSalesExecs   String[] @default([])
  /// Sales executives visible on Sale orders. ["*"] = all; else executive names.
  saleOrderSalesExecs     String[] @default([])
  /// Sales executives visible on Purchase orders. ["*"] = all; else executive names.
  purchaseOrderSalesExecs String[] @default([])
  /// Sales executives visible in Ageing Report. ["*"] = all; else executive names.
  ageingReportSalesExecs  String[] @default([])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  dealByCustomers   Customer[] @relation("DealBy")
  orders            Order[]
  bills             Bill[]
  createdPayments   Payment[]  @relation("PaymentCreatedBy")
  createdDiscounts  Discount[] @relation("DiscountCreatedBy")
  createdDispatches Dispatch[] @relation("DispatchCreatedBy")
}

model Transporter {
  id                  String   @id @default(cuid())
  /// Transport company name
  name                String
  ownerName           String?
  ownerContactNumber1 String?
  ownerContactNumber2 String?
  email               String?
  city                String?
  state               String?
  /// Carry-forward balance before this system (manual). Treated as on 01/08/2026.
  openingDue          Decimal  @default(0) @db.Decimal(18, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  dispatches Dispatch[]
  payments   Payment[]
  discounts  Discount[]
}

/// Managed list of origin names (Indonesia, Coal India, …).
model OriginOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qualityClasses QualityClass[]
}

/// Managed list of quality grades (6000 GCV, Coal Fines, …).
model QualityOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qualityClasses QualityClass[]
}

/// Managed list of ports / locations (Haldia Port, Odisha, …).
model PortOption {
  id        String   @id @default(cuid())
  name      String   @unique
  /// GST state for dispatches via vessels at this port.
  state     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vessels Vessel[]
  orders  Order[]
}

/// Managed list of sales executives (suggested on customers; stored as text).
model SaleExecutiveOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Managed list of cities (suggested on customers/transporters; stored as text).
model CityOption {
  id        String   @id @default(cuid())
  name      String   @unique
  state     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Managed list of states (suggested on customers/transporters; stored as text).
model StateOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Managed list of industry sectors (suggested on customers; stored as text).
model SectorOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Managed list of dealing companies (suggested across the app; stored as text).
model DealingCompanyOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Managed list of owner names (suggested on customers and transporters; stored as text).
model OwnerOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A coal quality class: origin + domestic flag + quality grade.
model QualityClass {
  id              String   @id @default(cuid())
  originId        String
  domestic        Boolean
  qualityOptionId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  origin         OriginOption    @relation(fields: [originId], references: [id])
  qualityOption  QualityOption   @relation(fields: [qualityOptionId], references: [id])
  vessels        Vessel[]
  orders         Order[]
  purchaseOrders PurchaseOrder[]

  @@unique([originId, domestic, qualityOptionId])
}

model Customer {
  id                        String             @id @default(cuid())
  name                      String
  category                  CustomerCategory
  active                    Boolean            @default(true)
  ownerName                 String?
  ownerContact              String?
  purchaserName             String?
  purchaserContact          String?
  purchaserRole             String?
  paymentInChargeName       String?
  paymentInChargeContact    String?
  paymentInChargeRole       String?
  accountantName            String?
  accountantContact         String?
  factoryContactName        String?
  factoryContactContact     String?
  factoryContactRole        String?
  email                     String?
  city                      String?
  state                     String?
  creditDays                Int?
  sector                    String?
  saleExecutive             String?
  dealById                  String?
  approachForFunds          String?
  /// Suggested dealing company name (from Options list; stored as text).
  dealingCompany            String?
  /// Carry-forward balance from before this system (manual). Included in `due`.
  openingDue                Decimal            @default(0) @db.Decimal(18, 2)
  /// Net amount owed by the customer to Rajshree (openingDue + sales − purchases − received + sent − discount paid + discount received).
  due                       Decimal            @default(0) @db.Decimal(18, 2)
  /// Next planned collection phone call date (calendar day).
  plannedCollectionCallDate DateTime?
  /// How the next collection follow-up will be made.
  collectionThrough         CollectionThrough?
  /// Next planned sales call date (calendar day) — separate from collection.
  plannedSaleCallDate       DateTime?
  /// Latest offer price (Rs/MT) noted on Sales Engine.
  offerPrice                Decimal?           @db.Decimal(18, 3)
  /// Latest offer freight (Rs/MT) noted on Sales Engine.
  offerFreight              Decimal?           @db.Decimal(18, 3)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  dealBy         Staff?          @relation("DealBy", fields: [dealById], references: [id])
  orders         Order[]
  purchaseOrders PurchaseOrder[]
  dispatches     Dispatch[]      @relation("DispatchImporter")
  payments       Payment[]
  discounts      Discount[]
}

model Vessel {
  id             String   @id @default(cuid())
  vesselName     String   @unique
  qualityClassId String?
  portId         String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  qualityClass   QualityClass?   @relation(fields: [qualityClassId], references: [id])
  port           PortOption?     @relation(fields: [portId], references: [id])
  purchaseOrders PurchaseOrder[]
  dispatches     Dispatch[]
}

/// Sale order (customer PO / selling side).
model Order {
  id              String         @id @default(cuid())
  poNumber        String         @unique
  orderType       OrderType      @default(REGULAR)
  customerId      String
  orderDate       DateTime?
  portId          String?
  creditDays      Int?
  qualityClassId  String?
  /// Base sale rate entered by user (Rs/MT), before GST/TCS.
  rate            Decimal?       @db.Decimal(18, 3)
  /// All-in sale rate: rate + GST(18%); traders also add TCS(2% of rate+GST).
  finalRate       Decimal?       @db.Decimal(18, 3)
  /// Null for open orders until completeOpenOrder fills it in.
  quantity        Decimal?       @db.Decimal(18, 3)
  /// Optional planned lorry count entered at order creation.
  numberOfLorries Int?
  /// Sale delivery terms (FOR / Ex-Port). Independent of dispatch terms. Null until set.
  deliveryTerms   DispatchTerms?
  orderById       String?
  /// Accumulated by dispatch transactions only — never write from forms.
  dispatchedOrder Decimal        @default(0) @db.Decimal(18, 3)
  /// Undispatchable remainder written off via "close quantity"; zeros balance.
  closingQuantity Decimal?       @db.Decimal(18, 3)
  orderStatus     OrderStatus    @default(RUNNING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id])
  orderBy      Staff?        @relation(fields: [orderById], references: [id])
  port         PortOption?   @relation(fields: [portId], references: [id])
  qualityClass QualityClass? @relation(fields: [qualityClassId], references: [id])
  dispatches   Dispatch[]
}

/// Purchase order (vendor / costing side). Linked to a vessel.
model PurchaseOrder {
  id              String              @id @default(cuid())
  poNumber        String              @unique
  orderType       OrderType           @default(REGULAR)
  importerId      String
  vesselId        String
  orderDate       DateTime?
  qualityClassId  String?
  /// Base cost rate entered by user (Rs/MT), before GST/TCS.
  rate            Decimal?            @db.Decimal(18, 3)
  /// All-in cost: rate + GST(18%) + TCS(2% of rate+GST).
  finalRate       Decimal?            @db.Decimal(18, 3)
  /// Null for open purchase orders until completed.
  quantity        Decimal?            @db.Decimal(18, 3)
  /// Accumulated by dispatch transactions only — never write from forms.
  dispatchedOrder Decimal             @default(0) @db.Decimal(18, 3)
  /// Undispatchable remainder written off via "close quantity"; zeros balance.
  closingQuantity Decimal?            @db.Decimal(18, 3)
  orderStatus     PurchaseOrderStatus @default(RUNNING)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  importer     Customer      @relation(fields: [importerId], references: [id])
  vessel       Vessel        @relation(fields: [vesselId], references: [id])
  qualityClass QualityClass? @relation(fields: [qualityClassId], references: [id])
  dispatches   Dispatch[]
}

model Dispatch {
  id                            String        @id @default(cuid())
  /// Sequential serial (DN 0001, DN 0002, …), assigned from the first dispatch.
  dispatchNumber                String?       @unique
  poNumber                      String
  purchasePoNumber              String
  vesselId                      String
  dispatchDate                  DateTime
  dispatchedQuantity            Decimal       @db.Decimal(18, 3)
  lorryNumber                   String?
  dispatchTerms                 DispatchTerms @default(EX_PORT)
  /// Freight per MT (Rs/MT) — required for FOR; stripped from sale rate for profit.
  freight                       Decimal?      @db.Decimal(18, 3)
  transporterId                 String?
  importerId                    String?
  receivingQuantity             Decimal?      @db.Decimal(18, 3)
  receiptDate                   DateTime?
  receiptStatus                 ReceiptStatus @default(PENDING)
  softCopyStatus                Boolean       @default(false)
  /// Purchase checklist — purchase invoice recorded in Tally accounting software.
  entryInTally                  Boolean       @default(false)
  /// Transport checklist — bilty (goods receipt) hard copy received.
  biltyHardCopy                 Boolean       @default(false)
  /// Transport checklist — transporter invoice number.
  transportInvoiceNo            String?
  /// Transport checklist — sale/transport invoice hard copy received.
  invoiceHardCopy               Boolean       @default(false)
  /// Transport checklist — transport invoice recorded in Tally accounting software.
  transportEntryInTally         Boolean       @default(false)
  /// Sale (customer) invoice number — often filled after dispatch.
  saleInvoiceNumber             String?
  /// Purchase (supplier) invoice number — often filled after dispatch.
  purchaseInvoiceNumber         String?
  purchaseChecklistCompletedAt  DateTime?
  saleChecklistCompletedAt      DateTime?
  transportChecklistCompletedAt DateTime?
  createdByStaffId              String?
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt

  order          Order         @relation(fields: [poNumber], references: [poNumber], onUpdate: Cascade)
  purchaseOrder  PurchaseOrder @relation(fields: [purchasePoNumber], references: [poNumber], onUpdate: Cascade)
  vessel         Vessel        @relation(fields: [vesselId], references: [id])
  transporter    Transporter?  @relation(fields: [transporterId], references: [id])
  importer       Customer?     @relation("DispatchImporter", fields: [importerId], references: [id])
  createdByStaff Staff?        @relation("DispatchCreatedBy", fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([receiptStatus])
  @@index([vesselId])
  @@index([purchasePoNumber])
  @@index([createdByStaffId])
}

/// Money received from or sent to a customer or transporter.
model Payment {
  id               String           @id @default(cuid())
  date             DateTime
  customerId       String?
  transporterId    String?
  createdByStaffId String?
  direction        PaymentDirection
  amount           Decimal          @db.Decimal(18, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  customer       Customer?    @relation(fields: [customerId], references: [id])
  transporter    Transporter? @relation(fields: [transporterId], references: [id])
  createdByStaff Staff?       @relation("PaymentCreatedBy", fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([transporterId])
  @@index([createdByStaffId])
  @@index([date])
}

/// Discount received from or paid to a customer or transporter.
model Discount {
  id               String         @id @default(cuid())
  date             DateTime
  customerId       String?
  transporterId    String?
  createdByStaffId String?
  status           DiscountStatus
  amount           Decimal        @db.Decimal(18, 2)
  /// Domestic coal vs imported coal. Null on older rows.
  coalOrigin       CoalOrigin?
  remarks          String         @default("")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  customer       Customer?    @relation(fields: [customerId], references: [id])
  transporter    Transporter? @relation(fields: [transporterId], references: [id])
  createdByStaff Staff?       @relation("DiscountCreatedBy", fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([transporterId])
  @@index([createdByStaffId])
  @@index([date])
}

/// Staff-uploaded bill awaiting owner approval.
model Bill {
  id               String     @id @default(cuid())
  /// Year-based approval reference (AN 2025-0001).
  approvalNo       String?    @unique
  date             DateTime
  /// Who issued the invoice (vendor / party name).
  invoiceIssuedBy  String     @default("")
  /// Invoice total in rupees.
  invoiceAmount    Decimal?   @db.Decimal(18, 2)
  /// Owner option name selected as the bill approver.
  approverName     String     @default("")
  /// Staff remark written at upload.
  remark           String
  status           BillStatus @default(PENDING)
  /// Owner remark written when approving or rejecting.
  reviewRemark     String     @default("")
  /// Tally / accounts voucher reference entered after approval.
  accountVoucherNo String     @default("")
  reviewedAt       DateTime?
  staffId          String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  staff Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  files BillFile[]

  @@index([staffId])
  @@index([status])
  @@index([date])
}

model BillFile {
  id        String   @id @default(cuid())
  billId    String
  fileName  String
  fileMime  String
  fileData  Bytes
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}
